<Window x:Class="AliceCoopLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Alice Co-op Launcher" Width="940" Height="720"
        MinWidth="820" MinHeight="620" WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}" WindowStyle="None"
        ResizeMode="CanResize" Icon="/Assets/aliceWhait.png">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="#464150" BorderThickness="1"
            Background="{StaticResource WindowBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#1D1D24" BorderBrush="#393541"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="12,0,0,0">
                        <Image Source="/Assets/aliceWhait.png" Width="23" Height="23"
                               Stretch="Uniform" Margin="0,0,9,0" />
                        <TextBlock Text="Alice Co-op Launcher" FontSize="13"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Content="—" Style="{StaticResource TitleButton}"
                                ToolTip="Minimize" Click="Minimize_Click" />
                        <Button x:Name="MaximizeButton" Content="□"
                                Style="{StaticResource TitleButton}"
                                ToolTip="Maximize" Click="Maximize_Click" />
                        <Button Content="×" Style="{StaticResource TitleButton}"
                                ToolTip="Close" FontSize="20" Click="Close_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" ClipToBounds="True">
                <Image Source="/Assets/AliceLauncher.jpg" Stretch="UniformToFill"
                       VerticalAlignment="Top" Height="470" Opacity="0.52">
                    <Image.OpacityMask>
                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                            <GradientStop Color="#DFFFFFFF" Offset="0" />
                            <GradientStop Color="#8FFFFFFF" Offset="0.48" />
                            <GradientStop Color="#00FFFFFF" Offset="1" />
                        </LinearGradientBrush>
                    </Image.OpacityMask>
                </Image>
                <Border>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                            <GradientStop Color="#3817171D" Offset="0" />
                            <GradientStop Color="#A817171D" Offset="0.48" />
                            <GradientStop Color="#FF17171D" Offset="0.78" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalAlignment="Stretch" PanningMode="VerticalOnly">
                    <Grid Margin="30,26,24,30">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="88" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="72" Height="72" Background="#C4302C3D"
                                    CornerRadius="16" HorizontalAlignment="Left">
                                <Image Source="/Assets/aliceWhait.png" Margin="8" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="ALICE CO-OP" FontSize="28"
                                           FontWeight="Bold" />
                                <TextBlock Text="Two-player co-op setup"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="14" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" VerticalAlignment="Center"
                                       HorizontalAlignment="Right" TextAlignment="Right"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="12">
                                <Run x:Name="VersionText" Text="Development build" />
                                <Run Text=" — " />
                                <Hyperlink NavigateUri="https://github.com/docwitson/Alice-Madness-Returns-Co-op"
                                           Foreground="{StaticResource AccentBrush}"
                                           RequestNavigate="OpenRepository_Click">GitHub repository</Hyperlink>
                                <LineBreak />
                                <Run Text="By Docwitson and contributors" />
                                <LineBreak />
                                <Hyperlink NavigateUri="https://github.com/docwitson/Alice-Madness-Returns-Co-op/blob/main/THIRD_PARTY_NOTICES.md"
                                           Foreground="{StaticResource AccentBrush}"
                                           RequestNavigate="OpenRepository_Click">Third-party</Hyperlink>
                                <Run Text=" · GPL-2.0" />
                            </TextBlock>
                        </Grid>

                        <Border x:Name="InstallPanel" Grid.Row="1"
                                Background="{StaticResource PanelBrush}"
                                CornerRadius="12" Padding="16" Margin="0,0,0,18">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Grid.ColumnSpan="4"
                                            Margin="0,0,0,9">
                                    <TextBlock Text="INSTALLATION" FontWeight="Bold"
                                               FontSize="15" />
                                    <TextBlock x:Name="InstallationStatusText" Margin="12,1,0,0"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               Text="Select an installed game." />
                                </StackPanel>
                                <ComboBox x:Name="GameInstallationComboBox" Grid.Row="1"
                                          SelectionChanged="GameInstallationComboBox_SelectionChanged" />
                                <Button x:Name="AddGameButton" Grid.Row="1" Grid.Column="1" Content="Add game…"
                                        Margin="8,0,0,0" Click="BrowseGame_Click" />
                                <Button x:Name="InstallButton" Grid.Row="1" Grid.Column="2"
                                        Content="Install" Style="{StaticResource PrimaryButton}"
                                        Margin="8,0,0,0" Click="Install_Click" />
                                <Button x:Name="RemoveButton" Grid.Row="1" Grid.Column="3"
                                        Content="Remove" Margin="8,0,0,0"
                                        Visibility="Collapsed" Click="Remove_Click" />
                            </Grid>
                        </Border>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="{StaticResource PanelBrush}"
                                    CornerRadius="12" Padding="22">
                                <StackPanel>
                                    <TextBlock Text="HOST GAME" FontSize="20" FontWeight="Bold" />
                                    <TextBlock Text="Start a co-op session on this PC."
                                               TextWrapping="Wrap" Margin="0,6,0,16"
                                               Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock Text="Address to share" FontWeight="SemiBold" />
                                    <ComboBox x:Name="LocalAddressComboBox" Margin="0,6,0,0"
                                              SelectionChanged="LocalAddressComboBox_SelectionChanged" />
                                    <Grid Margin="0,7,0,0">
                                        <TextBlock x:Name="RecommendedAddressText"
                                                   Text="Recommended network"
                                                   Foreground="{StaticResource SuccessBrush}"
                                                   FontSize="12" VerticalAlignment="Center" />
                                        <Button Content="Copy IP address" HorizontalAlignment="Right"
                                                Padding="10,5" Click="CopyAddress_Click"
                                                ToolTip="Copies the IP address and UDP port" />
                                    </Grid>
                                    <Button x:Name="HostButton" Content="HOST GAME"
                                            Style="{StaticResource PrimaryButton}"
                                            Margin="0,18,0,0" Click="Host_Click" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="{StaticResource PanelBrush}"
                                    CornerRadius="12" Padding="22">
                                <StackPanel>
                                    <TextBlock Text="JOIN GAME" FontSize="20" FontWeight="Bold" />
                                    <TextBlock Text="Enter the LAN or trusted VPN address shared by the host."
                                               TextWrapping="Wrap" Margin="0,6,0,16"
                                               Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock Text="Host address" FontWeight="SemiBold" />
                                    <Grid Margin="0,6,0,10">
                                        <TextBox x:Name="ServerAddressTextBox" Text=""
                                                 ToolTip="For example: 26.10.20.30:27018"
                                                 TextChanged="ServerAddressTextBox_TextChanged" />
                                        <TextBlock x:Name="HostAddressPlaceholder"
                                                   Text="Enter host IP or paste IP:port"
                                                   Foreground="#777282" Margin="11,0,0,0"
                                                   VerticalAlignment="Center"
                                                   IsHitTestVisible="False" />
                                    </Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="TestConnectionButton"
                                                Content="Test connection" IsEnabled="False"
                                                Click="TestConnection_Click" />
                                        <TextBlock x:Name="ProbeStatusText" Margin="12,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource MutedTextBrush}" />
                                    </StackPanel>
                                    <Button x:Name="JoinButton" Content="JOIN GAME"
                                            Style="{StaticResource PrimaryButton}"
                                            IsEnabled="False" Margin="0,18,0,0"
                                            Click="Join_Click" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Grid.Row="3" Background="{StaticResource PanelLightBrush}"
                                CornerRadius="12" Padding="16" Margin="0,18,0,0">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="SESSION STATUS" FontWeight="Bold" />
                                        <TextBlock x:Name="SessionStatusText" Text="Ready"
                                                   Margin="0,4,0,0"
                                                   Foreground="{StaticResource SuccessBrush}" />
                                        <TextBlock Text="One launcher window controls one game. Use a second window for another local copy."
                                                   Margin="0,3,0,0" FontSize="11"
                                                   Foreground="{StaticResource MutedTextBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button x:Name="SessionDetailsButton"
                                                Content="Show details" Margin="0,0,8,0"
                                                Click="ToggleSessionDetails_Click" />
                                        <Button Content="Open logs folder" Margin="0,0,8,0"
                                                Click="OpenLogs_Click" />
                                        <Button x:Name="StopHostingButton"
                                                Content="Stop hosting" Visibility="Collapsed"
                                                Click="StopRelay_Click" />
                                    </StackPanel>
                                </Grid>
                                <TextBox x:Name="SessionLogTextBox" Height="98"
                                         Margin="0,12,0,0" IsReadOnly="True"
                                         Visibility="Collapsed" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto" />
                            </StackPanel>
                        </Border>

                        <Expander Grid.Row="4" Header="Advanced settings"
                                  Margin="0,18,0,0" Foreground="{StaticResource TextBrush}"
                                  IsExpanded="False">
                            <Border Background="{StaticResource PanelBrush}" CornerRadius="12"
                                    Padding="18" Margin="0,10,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="UDP port" VerticalAlignment="Center" />
                                    <TextBox x:Name="PortTextBox" Grid.Column="1" Text="27018"
                                             Margin="10,0,0,0"
                                             TextChanged="PortTextBox_TextChanged" />
                                    <TextBlock Grid.Column="3" Text="Game display mode"
                                               VerticalAlignment="Center" />
                                    <ComboBox x:Name="DisplayModeComboBox" Grid.Column="4"
                                              Margin="10,0,0,0" SelectedIndex="0">
                                        <ComboBoxItem Content="Fullscreen" Tag="fullscreen" />
                                        <ComboBoxItem Content="Borderless" Tag="borderless" />
                                        <ComboBoxItem Content="Windowed" Tag="windowed" />
                                    </ComboBox>
                                    <Button Grid.Column="5" Content="Allow through Windows Firewall"
                                            HorizontalAlignment="Right" Click="Firewall_Click" />
                                </Grid>
                            </Border>
                        </Expander>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>
