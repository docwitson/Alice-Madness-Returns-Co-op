<Window x:Class="AliceCoopLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alice Co-op Launcher" Width="940" Height="720"
        MinWidth="820" MinHeight="640" WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}"
        Icon="/Assets/aliceWhait.png">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="88" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="72" Height="72" Background="#302C3D" CornerRadius="16">
                    <Image Source="/Assets/aliceWhait.png" Margin="8" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="ALICE CO-OP" FontSize="28" FontWeight="Bold" />
                    <TextBlock Text="Two-player launcher and connection setup"
                               Foreground="{StaticResource MutedTextBrush}" FontSize="14" />
                </StackPanel>
            </Grid>

            <Border x:Name="InstallPanel" Grid.Row="1" Background="{StaticResource PanelBrush}"
                    CornerRadius="12" Padding="20" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="INSTALLATION" FontWeight="Bold" FontSize="16" />
                    <TextBlock x:Name="InstallationStatusText" Margin="0,6,0,14"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="Select the folder containing AliceMadnessReturns.exe." />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="GameDirectoryTextBox" VerticalContentAlignment="Center" />
                        <Button Grid.Column="1" Content="Browse…" Margin="10,0,0,0"
                                Click="BrowseGame_Click" />
                        <Button x:Name="InstallButton" Grid.Column="2" Content="Install / Repair"
                                Style="{StaticResource PrimaryButton}" Margin="10,0,0,0"
                                Click="Install_Click" />
                    </Grid>
                </StackPanel>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource PanelBrush}"
                        CornerRadius="12" Padding="22">
                    <StackPanel>
                        <TextBlock Text="HOST GAME" FontSize="20" FontWeight="Bold" />
                        <TextBlock Text="Start a relay on this PC and host the campaign."
                                   TextWrapping="Wrap" Margin="0,6,0,16"
                                   Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock Text="Address to share" FontWeight="SemiBold" />
                        <ComboBox x:Name="LocalAddressComboBox" Margin="0,6,0,10" />
                        <Button Content="Copy address" HorizontalAlignment="Left"
                                Click="CopyAddress_Click" />
                        <Button x:Name="HostButton" Content="START HOST"
                                Style="{StaticResource PrimaryButton}" Margin="0,22,0,0"
                                Click="Host_Click" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="{StaticResource PanelBrush}"
                        CornerRadius="12" Padding="22">
                    <StackPanel>
                        <TextBlock Text="JOIN GAME" FontSize="20" FontWeight="Bold" />
                        <TextBlock Text="Enter the LAN or trusted VPN address shared by the host."
                                   TextWrapping="Wrap" Margin="0,6,0,16"
                                   Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock Text="Relay address" FontWeight="SemiBold" />
                        <TextBox x:Name="ServerAddressTextBox" Text="127.0.0.1"
                                 Margin="0,6,0,10" />
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="TestConnectionButton" Content="Test connection"
                                    Click="TestConnection_Click" />
                            <TextBlock x:Name="ProbeStatusText" Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource MutedTextBrush}" />
                        </StackPanel>
                        <Button x:Name="JoinButton" Content="JOIN SESSION"
                                Style="{StaticResource PrimaryButton}" Margin="0,22,0,0"
                                Click="Join_Click" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="3" Background="{StaticResource PanelLightBrush}"
                    CornerRadius="12" Padding="18" Margin="0,18,0,0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="SESSION STATUS" FontWeight="Bold" />
                            <TextBlock x:Name="SessionStatusText" Text="Ready"
                                       Margin="0,5,0,0" Foreground="{StaticResource SuccessBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Open logs" Margin="0,0,8,0" Click="OpenLogs_Click" />
                            <Button Content="Stop relay" Click="StopRelay_Click" />
                        </StackPanel>
                    </Grid>
                    <TextBox x:Name="SessionLogTextBox" Height="98" Margin="0,14,0,0"
                             IsReadOnly="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" />
                </StackPanel>
            </Border>

            <Expander Grid.Row="4" Header="Advanced settings" Margin="0,18,0,0"
                      Foreground="{StaticResource TextBrush}">
                <Border Background="{StaticResource PanelBrush}" CornerRadius="12"
                        Padding="18" Margin="0,10,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="UDP port" VerticalAlignment="Center" />
                        <TextBox x:Name="PortTextBox" Grid.Column="1" Text="27018"
                                 Margin="10,0,0,0" />
                        <TextBlock Grid.Column="3" Text="Display mode"
                                   VerticalAlignment="Center" />
                        <ComboBox x:Name="DisplayModeComboBox" Grid.Column="4"
                                  Margin="10,0,0,0" SelectedIndex="0">
                            <ComboBoxItem Content="Fullscreen" Tag="fullscreen" />
                            <ComboBoxItem Content="Borderless" Tag="borderless" />
                            <ComboBoxItem Content="Windowed" Tag="windowed" />
                        </ComboBox>
                        <Button Grid.Column="5" Content="Allow relay in Firewall"
                                HorizontalAlignment="Right" Click="Firewall_Click" />
                    </Grid>
                </Border>
            </Expander>
        </Grid>
    </ScrollViewer>
</Window>
